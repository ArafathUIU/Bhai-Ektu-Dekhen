# AI worker configuration (loads from environment or this file).

# URL prefix served by FastAPI.
# API_V1_PREFIX=/api/v1

# Where Laravel receives AI results (reserved for the internal result webhook).
# BACKEND_RESULT_URL=http://127.0.0.1:8000/api/v1/internal/ai-results
# BACKEND_WORKER_TOKEN=worker-token-change-me

# Classification: minimum confidence to trust a category guess.
# MIN_CONFIDENCE=0.35

# Duplicate detection tuning (mirrored in backend config/ai.php).
# DUPLICATE_GEO_RADIUS_M=300
# DUPLICATE_IMAGE_THRESHOLD=0.75
# DUPLICATE_TEXT_THRESHOLD=0.60
# DUPLICATE_OVERALL_THRESHOLD=0.70